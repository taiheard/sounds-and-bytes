---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Soundtracks · Taiwo Heard" description="Explore musical journeys through cinematic Score Reel and Music for the People. Original compositions across genres and mediums.">
    <style slot="head">
        .main-background {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -2;
            background: linear-gradient(rgba(10, 10, 10, 0.85), rgba(10, 10, 10, 0.75)), url('/sounds-and-bytes/images/Studio shot hound.jpeg');
            background-size: cover; background-position: center; opacity: 0.5;
        }

        .overlay-pattern {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1;
            background: 
                radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.02) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.02) 0%, transparent 50%);
        }

        .hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 2rem; position: relative; overflow: hidden; }
        
        .hero-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(255, 107, 107, 0.15), transparent 60%),
                        radial-gradient(circle at 80% 20%, rgba(255, 217, 61, 0.1), transparent 40%);
            z-index: 1;
        }

        .hero-svg-waves {
            position: absolute;
            bottom: -80px; left: -15%;
            width: 130%; height: 360px;
            z-index: 2; pointer-events: none; opacity: 0.6;
        }
        .hero-svg-waves svg { width: 100%; height: 100%; display: block; }
        @keyframes waveMove {
            0% { transform: translateX(0); }
            100% { transform: translateX(-60px); }
        }
        .hero-svg-waves .wave1 { animation: waveMove 8s linear infinite alternate; }
        .hero-svg-waves .wave2 { animation: waveMove 12s linear infinite alternate-reverse; }

        .hero-content { max-width: 1200px; margin: 0 auto; position: relative; z-index: 3; padding: 0 2rem; }

        .hero h1 { 
            font-size: clamp(3.5rem, 10vw, 9rem); font-weight: 900; line-height: 0.9; text-transform: uppercase; 
            background: linear-gradient(to right, #fff, #aaa); -webkit-background-clip: text; background-clip: text; color: transparent;
            opacity: 0; animation: fadeInUp 1s 0.5s forwards;
        }
        @media (min-width: 769px) {
            .hero h1 {
                white-space: nowrap;
            }
        }
        .hero h1 .playful { font-family: var(--font-playful); background: linear-gradient(90deg, var(--accent-playful2), var(--accent-playful), var(--accent-primary)); -webkit-background-clip: text; background-clip: text; color: transparent; font-size: 1.1em; display: inline-block; }

        .hero-subtitle { font-family: var(--font-mono); font-size: clamp(1.1rem, 3vw, 2rem); color: var(--text-muted); margin-bottom: 1.5rem; margin-top: 1.5rem; opacity: 0; animation: fadeInUp 1s 1s forwards; }
        .hero-description { font-size: clamp(1rem, 2vw, 1.3rem); color: var(--text-muted); line-height: 1.8; max-width: 700px; margin: 0 auto 3rem; opacity: 0; animation: fadeInUp 1s 1.5s forwards; }

        .scroll-indicator { position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); opacity: 0.5; z-index: 4; }

        .soundtracks-grid { max-width: 1400px; margin: 0 auto; padding: 6rem 2rem; display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(3, 200px); gap: 2rem; position: relative; }
        
        .soundtrack-card { 
            background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; 
            padding: 2.5rem; text-decoration: none; color: inherit; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
            position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center;
        }
        .soundtrack-card::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 2px; background: var(--gradient-main); transition: left 0.8s ease; }
        .soundtrack-card:hover::before { left: 100%; }
        .soundtrack-card:hover { transform: translateY(-10px) scale(1.01); background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.3); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4); }

        .score-reel { grid-column: 1 / span 6; grid-row: 1 / span 3; background: linear-gradient(135deg, rgba(255, 107, 53, 0.1) 0%, rgba(138, 43, 226, 0.05) 100%); }
        .music-people { grid-column: 7 / span 6; grid-row: 1 / span 3; background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%); }

        .card-title { font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 800; margin-bottom: 1rem; text-transform: uppercase; }
        .card-subtitle { font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 1.5rem; }
        .card-description { color: #ccc; line-height: 1.7; font-size: clamp(0.95rem, 1.8vw, 1.1rem); }

        .floating-element { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); animation: float 20s ease-in-out infinite; }
        .floating-element:nth-child(1) { width: 100px; height: 100px; top: 20%; left: 10%; animation-delay: 0s; }
        .floating-element:nth-child(2) { width: 60px; height: 60px; top: 60%; right: 15%; animation-delay: 7s; }
        .floating-element:nth-child(3) { width: 80px; height: 80px; bottom: 20%; left: 70%; animation-delay: 14s; }

        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes float { 0%, 100% { transform: translateY(0px) rotate(0deg); } 33% { transform: translateY(-20px) rotate(120deg); } 66% { transform: translateY(10px) rotate(240deg); } }

        @media (max-width: 1024px) {
            .soundtracks-grid { grid-template-columns: 1fr; grid-template-rows: auto; padding: 4rem 2rem; }
            .score-reel, .music-people { grid-column: 1 / -1; grid-row: auto; min-height: 300px; }
            .floating-element { display: none; }
            .hero { padding-top: 6rem; }
        }
        @media (max-width: 768px) {
            .hero {
                padding-top: 6rem;
                min-height: auto;
                padding-bottom: 4rem;
            }
            .hero h1 { font-size: clamp(2.5rem, 12vw, 4rem); }
            .hero-subtitle { font-size: 1.2rem; margin-bottom: 1.5rem; }
            .hero-description { font-size: 1rem; line-height: 1.6; }
            .soundtracks-grid { padding: 2rem 1rem; gap: 1.5rem; }
            .soundtrack-card { padding: 2rem; }
            .card-title { font-size: clamp(1.6rem, 8vw, 2.2rem); line-height: 1.1; }
            .card-description { font-size: 0.95rem; line-height: 1.6; }
            .card-subtitle { margin-bottom: 1rem; font-size: 0.9rem; }
        }
    </style>

    <div class="main-background"></div>
    <div class="overlay-pattern"></div>

    <section class="hero">
        <div class="hero-bg"></div>
        <div class="hero-svg-waves">
            <svg viewBox="0 0 2000 200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path class="wave1" d="M0,100 Q200,40 400,100 T800,100 T1200,100 T1600,100 T2000,100 L2000,100 Q1800,160 1600,100 T1200,100 T800,100 T400,100 T0,100 Z" fill="#7ec4ff" fill-opacity="0.2"/>
                <path class="wave2" d="M0,100 Q100,160 200,100 T400,100 T600,100 T800,100 T1000,100 T1200,100 T1400,100 T1600,100 T1800,100 T2000,100 L2000,100 Q1900,40 1800,100 T1600,100 T1400,100 T1200,100 T1000,100 T800,100 T600,100 T400,100 T200,100 T0,100 Z" fill="#ffb3ec" fill-opacity="0.15"/>
                <path d="M0,100 Q400,70 800,100 T1600,100 T2000,100 L2000,100 Q1800,130 1600,100 T800,100 T0,100 Z" fill="#ffd93d" fill-opacity="0.12"/>
            </svg>
        </div>
        <div class="hero-content">
            <h1><span class="playful">SOUNDTRACKS</span></h1>
            <p class="hero-subtitle">Original Music Across Genres and Mediums</p>
            <p class="hero-description">
                Explore two distinct musical journeys: cinematic Score Reel compositions for film and media, and the ever-evolving Music for the People—an immersive musical web experience that transforms across moods and moments. From orchestral drama to genre-bending rock, these are soundtracks that find their own home.
            </p>
        </div>
        <div class="scroll-indicator">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
            </svg>
        </div>
    </section>

    <div class="floating-element"></div>
    <div class="floating-element"></div>
    <div class="floating-element"></div>

    <main class="soundtracks-grid">
        <a href="/sounds-and-bytes/score-reel" class="soundtrack-card score-reel">
            <h2 class="card-title">Score Reel</h2>
            <p class="card-subtitle">Cinematic Compositions</p>
            <p class="card-description">
                Musical compositions for film, games, and commercials. From high-energy car commercials to epic documentary trailers, these tracks showcase orchestral, electronic, and hybrid scoring techniques. Each composition is crafted to elevate the visual story—whether that means building tension, delivering emotional impact, or driving adrenaline.
            </p>
        </a>

        <a href="/sounds-and-bytes/music-for-the-people" class="soundtrack-card music-people">
            <h2 class="card-title">Music for the People</h2>
            <p class="card-subtitle">A Morphing Musical Experience</p>
            <p class="card-description">
                An immersive web experience where music and visuals transform across three distinct moods: Chill, Dance Party, and Strange. What makes it unique? Each mode features curated tracks with dynamic theming that evolves the entire aesthetic in real-time, the new interface revealing new musical video content.
            </p>
        </a>
    </main>

    <script is:inline>
        // Intersection Observer for progressive reveal
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe all soundtrack cards
        document.querySelectorAll('.soundtrack-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            card.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
            observer.observe(card);
        });

        // Parallax effect for background
        let ticking = false;
        function updateParallax() {
            const scrolled = window.pageYOffset;
            const background = document.querySelector('.main-background');
            if (background) {
                const rate = scrolled * -0.2;
                background.style.transform = `translate3d(0, ${rate}px, 0)`;
            }
            ticking = false;
        }

        function requestParallaxTick() {
            if (!ticking) {
                requestAnimationFrame(updateParallax);
                ticking = true;
            }
        }

        window.addEventListener('scroll', requestParallaxTick, { passive: true });

        // Respect reduced motion preferences
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('*').forEach(el => {
                el.style.scrollBehavior = 'auto';
                el.style.animationDuration = '0.01ms';
                el.style.animationIterationCount = '1';
                el.style.transitionDuration = '0.01ms';
            });
        }
    </script>
</BaseLayout>

