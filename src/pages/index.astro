---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout description="Portfolio of Taiwo Heard: Audio engineer, composer, and creative technologist. Explore soundtracks, interactive experiences, and innovative audio tools.">
    <style slot="head">
        /* Page-specific styles */
        /* =========================================
           HERO SECTION (BOLD VISUALS)
           ========================================= */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 0 2rem;
            overflow: hidden;
        }

        /* Dynamic Background Mesh + Playful SVG Waves */
        .hero-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(255, 107, 107, 0.15), transparent 60%),
                        radial-gradient(circle at 80% 20%, rgba(255, 217, 61, 0.1), transparent 40%);
            z-index: 2;
        }

        .hero-curtain-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('/sounds-and-bytes/images/curtain_image.jpg');
            background-size: cover;
            background-position: center;
            opacity: 0.02;
            z-index: 1;
            pointer-events: none;
            -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 95%);
            mask-image: linear-gradient(to bottom, black 60%, transparent 95%);
        }
        .hero-svg-waves {
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 130%;
            height: 180px;
            z-index: 2;
            pointer-events: none;
            opacity: 0.85;
        }
        .hero-svg-waves svg {
            width: 100%;
            height: 100%;
            display: block;
        }
        /* Animate the SVG waves */
        @keyframes waveMove {
            0% { transform: translateX(0); }
            100% { transform: translateX(-60px); }
        }
        .hero-svg-waves .wave1 {
            animation: waveMove 8s linear infinite alternate;
        }
        .hero-svg-waves .wave2 {
            animation: waveMove 12s linear infinite alternate-reverse;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            text-align: center;
            max-width: 1000px;
        }

        /* === PLAYFUL TYPOGRAPHY: Only on main hero heading === */
        .hero h1 {
            font-size: clamp(3.5rem, 10vw, 9rem);
            line-height: 0.9;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -0.02em;
            margin-bottom: 1.5rem;
            background: linear-gradient(to right, #fff, #aaa);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: fadeUp 1s ease-out forwards;
        }
        .hero h1 .playful {
            font-family: var(--font-playful);
            color: var(--accent-playful2);
            background: linear-gradient(90deg, var(--accent-playful2), var(--accent-playful), var(--accent-primary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 0.01em;
            font-size: 1.1em;
            display: inline-block;
            transition: color 0.3s;
        }
        .hero h1 .playful:hover {
            color: var(--accent-primary);
            filter: brightness(1.2);
        }

        .hero h1 span {
            display: block;
            font-size: 0.4em;
            font-family: var(--font-mono);
            color: var(--accent-primary);
            background: none;
            -webkit-text-fill-color: initial;
            letter-spacing: 2px;
            margin-bottom: 10px;
        }

        .hero-subtitle {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 3rem;
            opacity: 0;
            animation: fadeUp 1s ease-out 0.3s forwards;
        }

        .scroll-indicator {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
            opacity: 0.5;
            z-index: 4;
        }

        /* =========================================
           BENTO GRID LAYOUT
           ========================================= */
        .main-grid {
            max-width: 1600px;
            margin: 0 auto;
            padding: 4rem 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            position: relative;
            z-index: 2;
        }

        @media (max-width: 768px) {
            .main-grid {
                padding: 2rem 1rem;
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            .hero {
                padding: 0 1rem;
            }
            .hero h1 {
                font-size: clamp(2.5rem, 12vw, 4rem);
            }
            .hero-subtitle {
                font-size: 1rem;
                margin-bottom: 2rem;
            }
            .card {
                height: auto;
                min-height: 300px;
                padding: 1.5rem;
            }
            .card-content h2 {
                font-size: 1.5rem;
            }
            .card-badge {
                top: 15px;
                right: 15px;
                font-size: 0.6rem;
            }
        }

        @media (min-width: 1300px) {
            .main-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 2.5rem;
            text-decoration: none;
            color: #fff;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 350px;
        }

        @media (min-width: 900px) {
            .card.featured {
                grid-column: span 2;
                border-color: rgba(255, 107, 107, 0.3);
            }
        }

        @media (min-width: 1300px) {
            .card.byte-symphony {
                grid-column: 2;
            }
        }

        .card:hover {
            transform: translateY(-10px) scale(1.01);
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.3);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .card.featured:hover {
            box-shadow: 0 20px 50px rgba(255, 107, 107, 0.15);
            border-color: var(--accent-primary);
        }

        .card-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: var(--gradient-main);
            color: #000;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 20px;
            text-transform: uppercase;
            z-index: 2;
        }

        .card-content {
            position: relative;
            z-index: 2;
        }

        .card-content h2 {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            line-height: 1;
        }

        .card-content p {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .card-desc {
            font-size: 1rem;
            color: #ccc;
            margin-bottom: 2rem;
            flex-grow: 1;
            position: relative;
            z-index: 2;
        }

        .card-arrow {
            align-self: flex-start;
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--accent-primary);
            position: relative;
            z-index: 2;
        }

        .card-arrow::after {
            content: '→';
            transition: transform 0.3s ease;
        }

        .card:hover .card-arrow::after {
            transform: translateX(5px);
        }
    </style>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-bg"></div>
        <div class="hero-curtain-bg"></div>
        <!-- Playful SVG organic waves at the bottom of hero -->
        <div class="hero-svg-waves">
            <svg viewBox="0 0 2000 180" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path class="wave1" d="M0,120 Q360,180 720,120 T1440,120 T2000,120 V180 H0 Z" fill="#7ec4ff" fill-opacity="0.18"/>
                <path class="wave2" d="M0,140 C200,140 400,100 600,140 C800,180 1000,100 1200,140 C1400,180 1600,100 1800,140 C1900,160 1950,150 2000,140 V180 H0 Z" fill="#ffb3ec" fill-opacity="0.13"/>
                <path d="M0,160 Q360,100 720,160 T1440,160 T2000,160 V180 H0 Z" fill="#ffd93d" fill-opacity="0.10"/>
            </svg>
        </div>
        <div class="hero-content">
            <h1>
                <span>Audio • Data • R&D</span>
                <span class="playful">Sounds &amp; Bytes</span>
            </h1>
            <p class="hero-subtitle">Building at the intersection of sound and creative technology.</p>
        </div>
        <div class="scroll-indicator">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
            </svg>
        </div>
    </section>

    <!-- Main Grid -->
    <main class="main-grid" id="work">
        <!-- Sweetspot (Featured) -->
        <a href="/sounds-and-bytes/sweetspot" class="card featured sweetspot">
            <div class="card-badge">Featured Project</div>
            <div class="card-content">
                <h2>SWEETSPOT</h2>
                <p>Microphone Distance Trainer</p>
                <div class="card-desc">
                    Maintaining proper mic distance is tricky without visual feedback. <strong>Sweetspot</strong> shows you when you're in the optimal recording zone through color-coded indicators, helping you develop consistent mic technique over time.
                </div>
            </div>
            <div class="card-arrow">Explore Tool</div>
        </a>
        <!-- Scribbles -->
        <a href="/sounds-and-bytes/scribbles" class="card scribbles">
            <div class="card-content">
                <h2>SCRIBBLES</h2>
                <p>Blog & Musings</p>
                <div class="card-desc">
                    Honest takes on coding adventures, audio production, and the random thoughts that come with creating digital things.
                </div>
            </div>
            <div class="card-arrow">Read Blog</div>
        </a>
        <!-- Post Audio -->
        <a href="/sounds-and-bytes/post-production-audio-reel" class="card post-audio">
            <div class="card-content">
                <h2>POST AUDIO</h2>
                <p>Cinematic Production</p>
                <div class="card-desc">
                    Dialogue editing, sound design, Foley, ADR, mixing—the invisible work that makes audiences feel what they're watching. Here's the reel.
                </div>
            </div>
            <div class="card-arrow">Watch Reel</div>
        </a>
        <!-- Soundtracks -->
        <a href="/sounds-and-bytes/soundtracks" class="card soundtracks">
            <div class="card-content">
                <h2>SOUNDTRACKS</h2>
                <p>Original Composition</p>
                <div class="card-desc">
                    Film scores, rock bands, commercials, weird passion projects. Good music doesn't wait for permission—it finds its own home.
                </div>
            </div>
            <div class="card-arrow">Listen Now</div>
        </a>
        <!-- Flow States -->
        <a href="/sounds-and-bytes/flow-states" class="card flow-states">
            <div class="card-content">
                <h2>FLOW STATES</h2>
                <p>Interactive Experience</p>
                <div class="card-desc">
                    A scrolling storytelling journey built for the nights when your brain won't shut off. Art, ambient sound/music, and breathing techniques designed to guide you from restless to rested.
                </div>
            </div>
            <div class="card-arrow">Start Journey</div>
        </a>
        <!-- Byte Symphony -->
        <a href="/sounds-and-bytes/byte-symphony" class="card byte-symphony">
            <div class="card-content">
                <h2>BYTE SYMPHONY</h2>
                <p>Development & Analytics</p>
                <div class="card-desc">
                    Tools, experiments, and data-driven projects. The highlight? <strong>Dreamy</strong>—a chatbot that actually understands YouTube metrics and tells you what they mean in plain English.
                </div>
            </div>
            <div class="card-arrow">Explore Projects</div>
        </a>
    </main>
</BaseLayout>

