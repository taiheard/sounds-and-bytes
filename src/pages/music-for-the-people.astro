      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
        <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
      </svg>
    </div>
  </section>

  <!-- Music Player -->
  <div class="music-player">
    <div class="player-header">
      <div class="track-info">
        <h3 id="trackTitle">Select a track...</h3>
        <p id="trackArtist">Taiwo Heard</p>
      </div>
      <label class="autoplay-toggle">
        <span>Auto</span>
        <input type="checkbox" id="autoplayCheck">
        <div class="toggle-switch"></div>
      </label>
    </div>
    <div class="player-controls">
      <button class="control-btn" id="prevBtn" aria-label="Previous Track">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 20L9 12L19 4V20ZM5 19H7V5H5V19Z" fill="currentColor"/></svg>
      </button>
      <button class="control-btn play-pause" id="playBtn" aria-label="Play">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" id="playIcon"><path d="M8 5V19L19 12L8 5Z" fill="currentColor"/></svg>
      </button>
      <button class="control-btn" id="nextBtn" aria-label="Next Track">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 4L15 12L5 20V4ZM17 5H19V19H17V5Z" fill="currentColor"/></svg>
      </button>
      <button class="control-btn" id="shuffleBtn" aria-label="Shuffle">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10.59 9.17L5.41 4L4 5.41L9.17 10.58L10.59 9.17ZM14.5 4L16.54 6.04L4 18.59L5.41 20L17.96 7.46L20 9.5V4H14.5ZM14.83 13.41L13.42 14.82L16.55 17.95L14.5 20H20V14.5L17.96 16.54L14.83 13.41Z" fill="currentColor"/></svg>
      </button>
    </div>
    <div class="progress-container">
      <span id="currentTime">0:00</span>
      <div class="progress-bar" id="progressBar">
        <div class="progress-fill" id="progressFill"></div>
      </div>
      <span id="duration">0:00</span>
    </div>

    <!-- Mobile Mood Selector - only visible on mobile -->
    <div class="mobile-mood-selector">
      <span class="mood-word active" data-mode="chill">Chill</span>
      <span class="mood-word" data-mode="dance">Dance</span>
      <span class="mood-word" data-mode="strange">Strange</span>
    </div>

    <audio id="audioPlayer" preload="metadata"></audio>
  </div>

  <!-- Video Section -->
  <section class="video-section">
    <h2 class="section-title" id="sectionTitle">Chill Vibes</h2>
    <p class="section-description" id="sectionDescription">Simple atmospheric loops that breathe with the music.</p>
    <div class="video-grid" id="videoGrid">
      {Object.entries(videoData).map(([mode, videos]) => 
        videos.map((video, index) => (
          <div 
            class={`video-card mode-${mode} ${mode === 'chill' ? 'active' : ''} ${mode === 'chill' ? `chill-tint-${index + 1}` : ''}`} 
            data-mode={mode}
            data-video-id={video.id}
            data-video-title={video.title}
            data-video-description={video.description}
          >
            <Image 
              src={video.thumbnail} 
              alt={video.title} 
              width={800} 
              height={450} 
              class="video-thumbnail"
            />
            <div class="play-overlay">
              <div class="play-icon"></div>
            </div>
            <div class="video-overlay">
              <h3 class="video-title">{video.title}</h3>
              <p class="video-description">{video.description}</p>
            </div>
          </div>
        ))
      )}
    </div>

    <!-- Bio Section -->
    <div class="bio-container" id="bioContainer">
        <div class="bio-image-wrapper">
        <img id="modeImage" src="/sounds-and-bytes/images/Taiwo Heard InstaBub1.JPG" alt="Taiwo Heard Artistic Vision">
        </div>
      <div class="bio-content">
        <h3 class="bio-mode-title" id="bioTitle">CHILL MODE (The Solid Foundation)</h3>
        <p class="bio-text" id="bioText">
          At six, Taiwo learned piano by eavesdropping—siblings' lessons through the wall, notes absorbed like osmosis. Classical training felt like constraint until his father's wisdom reframed it: rules aren't walls, they're launch pads. Chill is the bedrock state. Simple arrangements where negative space does the work. Studio recordings that refuse polish because the imperfections *are* the story. Guitar, voice, maybe keys. No layering to hide behind. This is where the instrument and the body become the same thing—breath control, string tension, the physics of vibration translated through bone.
        </p>
      </div>
    </div>
  </section>

  <!-- Video Modal -->
  <div class="video-modal" id="videoModal">
    <div class="video-modal-content">
      <div class="video-modal-header">
        <h3 class="video-modal-title" id="modalVideoTitle">Video Title</h3>
        <button class="video-modal-close" id="modalCloseBtn" aria-label="Close video">✕</button>
      </div>
      <iframe id="modalVideoFrame" src="" title="Video Player" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      <div class="video-modal-info">
        <p class="video-modal-description" id="modalVideoDescription">Video description will appear here.</p>
      </div>
    </div>
  </div>

  <script is:inline>
    // Music and Video Data
    const musicData = {
      chill: [
        { file: '/sounds-and-bytes/Music tracks/Chill/Hearts in the Wild ( Master ) 48kHz 24Bit.m4a', title: 'Hearts in the Wild', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Chill/04 Eternal Night.mp3', title: 'Eternal Night', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Chill/DL acoustic Feb 5.mp3', title: 'DL Acoustic', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Chill/How To Survive.mp3', title: 'How To Survive', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Chill/I Cling To The Light.mp3', title: 'I Cling To The Light', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Chill/ToTheLightAcoustic.mp3', title: 'To The Light (Acoustic)', artist: 'Taiwo Heard' }
      ],
      dance: [
        { file: '/sounds-and-bytes/Music tracks/Dance Rave/AVALON ver.2 (YouTube).mp3', title: 'Avalon v2', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Dance Rave/01 Cyclone.mp3', title: 'Cyclone', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Dance Rave/03 Ticket.mp3', title: 'Ticket', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Dance Rave/AVALON ( Master ) 48kHz 24Bit.m4a', title: 'Avalon', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Dance Rave/Cyclone Dance_astro.m4a', title: 'Cyclone Dance', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Dance Rave/Treasure ( Master ) 48kHz 24Bit.m4a', title: 'Treasure', artist: 'Taiwo Heard' }
      ],
      strange: [
        { file: '/sounds-and-bytes/Music tracks/Strange/KISSES LIE  - INSTRUMENTAL.m4a', title: 'Kisses Lie (Instrumental)', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Strange/8-BIT MORE FINAL.mp3', title: '8-Bit More', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Strange/Good Other 8-bit final.mp3', title: 'Good Other 8-bit', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Strange/Spacewalk.mp3', title: 'Spacewalk', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Strange/TaiwoCamiloSynthJam.mp3', title: 'Synth Jam', artist: 'Taiwo Heard' },
        { file: '/sounds-and-bytes/Music tracks/Strange/AnanthamaJamStudioB.m4a', title: 'Ananthama Jam', artist: 'Taiwo Heard' }
      ]
    };

    // --- Optimized Video Logic (Relay & Thumbnails) ---
    function toggleBackgroundVideos(shouldPlay) {
      const activeVideo = document.querySelector(`.theme-background.${currentMode}-bg video`);
      if (activeVideo) {
        if (shouldPlay) {
          activeVideo.play().catch(() => {});
        } else {
          activeVideo.pause();
        }
      }
    }
    // ------------------------------------------------

    // Application State
    let currentMode = 'chill';
    let currentTrackIndex = 0;
    let isPlaying = false;
    let isShuffled = false;
    let currentPlaylist = [];
    let autoplayEnabled = false;

    // Local Storage Functions
    function saveCurrentMode(mode) {
      try {
        localStorage.setItem('musicPlayerMode', mode);
      } catch (e) {
        console.warn('Failed to save mode to localStorage:', e);
      }
    }

    function loadSavedMode() {
      try {
        const savedMode = localStorage.getItem('musicPlayerMode');
        if (savedMode && ['chill', 'dance', 'strange'].includes(savedMode)) {
          return savedMode;
        }
      } catch (e) {
        console.warn('Failed to load mode from localStorage:', e);
      }
      return 'chill'; // Default fallback
    }

    // DOM Elements
    const body = document.body;
    const modeKnob = document.getElementById('modeKnob');
    const modeLabels = document.querySelectorAll('.mode-label');
    const mobileMoodWords = document.querySelectorAll('.mood-word');
    const heroTitle = document.getElementById('heroTitle');
    const heroSubtitle = document.getElementById('heroSubtitle');
    const sectionTitle = document.getElementById('sectionTitle');
    const sectionDescription = document.getElementById('sectionDescription');
    const videoGrid = document.getElementById('videoGrid');
    const audioPlayer = document.getElementById('audioPlayer');
    const playBtn = document.getElementById('playBtn');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const shuffleBtn = document.getElementById('shuffleBtn');
    const trackTitle = document.getElementById('trackTitle');
    const trackArtist = document.getElementById('trackArtist');
    const progressFill = document.getElementById('progressFill');
    const progressBar = document.getElementById('progressBar');
    const currentTime = document.getElementById('currentTime');
    const duration = document.getElementById('duration');
    
    // Video Modal Elements
    const videoModal = document.getElementById('videoModal');
    const modalVideoTitle = document.getElementById('modalVideoTitle');
    const modalVideoDescription = document.getElementById('modalVideoDescription');
    const modalCloseBtn = document.getElementById('modalCloseBtn');

    // Initialize Application
    function init() {
      createParticles();
      setupModeSelector();
      setupMobileMoodSelector();
      setupMusicPlayer();
      setupVideoModal();
      setupVideoGridEvents();
      
      // Load autoplay preference
      autoplayEnabled = localStorage.getItem('autoplayEnabled') === 'true';
      const autoplayCheck = document.getElementById('autoplayCheck');
      if (autoplayCheck) {
        autoplayCheck.checked = autoplayEnabled;
        autoplayCheck.addEventListener('change', (e) => {
          autoplayEnabled = e.target.checked;
          localStorage.setItem('autoplayEnabled', autoplayEnabled);
        });
      }

      // Load saved mode from localStorage or use default
      const savedMode = loadSavedMode();
      
      // Force initial load by temporarily setting currentMode to null
      currentMode = null;
      loadMode(savedMode);

      // Initialize background videos for the current mode
      updateBackgroundVideos(savedMode);

      // Add parallax effect
      setupParallax();

      // Attempt initial autoplay after everything is loaded
      setTimeout(() => {
        attemptAutoPlay();
      }, 1000);
    }

    // Create animated background particles
    function createParticles() {
      const particlesContainer = document.getElementById('particles');
      for (let i = 0; i < 50; i++) {
        const particle = document.createElement('div');
        particle.className = 'particle';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.animationDelay = Math.random() * 20 + 's';
        particle.style.animationDuration = (Math.random() * 20 + 10) + 's';
        particlesContainer.appendChild(particle);
      }
    }

    // Setup mode selector knob
    function setupModeSelector() {
      const positions = [0, 120, 240];
      const positionModes = ['chill', 'dance', 'strange'];
      let currentPositionIndex = 0;

      function updateKnobRotation(rotation) {
        modeKnob.style.transform = `rotate(${rotation}deg)`;
        modeKnob.dataset.rotation = rotation;
      }
      
      window.updateKnobRotation = (rotation) => {
        for (let i = 0; i < positions.length; i++) {
          if (Math.abs(rotation - positions[i]) < 30) {
            currentPositionIndex = i;
            break;
          }
        }
        modeKnob.style.transform = `rotate(${rotation}deg)`;
        modeKnob.dataset.rotation = rotation;
      };

      function moveToNextPosition() {
        currentPositionIndex = (currentPositionIndex + 1) % positions.length;
        const newMode = positionModes[currentPositionIndex];
        const targetPosition = positions[currentPositionIndex];
        
        modeKnob.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        updateKnobRotation(targetPosition);
        
        if (navigator.vibrate) {
          navigator.vibrate(50);
        }
        
        loadMode(newMode);

        setTimeout(() => {
          modeKnob.style.transition = '';
        }, 300);
      }

      modeKnob.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        moveToNextPosition();
      });

      modeKnob.addEventListener('touchend', (e) => {
        e.preventDefault();
        e.stopPropagation();
        moveToNextPosition();
      });

      modeLabels.forEach(label => {
        label.addEventListener('click', () => {
          const mode = label.dataset.mode;
          loadMode(mode);
        });
      });
    }

    // Setup mobile mood selector
    function setupMobileMoodSelector() {
      mobileMoodWords.forEach(word => {
        word.addEventListener('click', () => {
          const mode = word.dataset.mode;
          loadMode(mode);
        });
      });
    }

    // Load and transition to new mode
    function loadMode(mode) {
      if (mode === currentMode) return;
      
      currentMode = mode;
      
      saveCurrentMode(mode);
      
      body.className = `theme-${mode}`;
      
      updateBackgroundVideos(mode);
      
      modeLabels.forEach(label => {
        label.classList.toggle('active', label.dataset.mode === mode);
      });

      // Update mobile mood words
      mobileMoodWords.forEach(word => {
        word.classList.toggle('active', word.dataset.mode === mode);
      });

      updateContent(mode);
      updateVideoGrid(mode);
      loadPlaylist(mode);

      setTimeout(() => {
        if (!isPlaying) {
          attemptAutoPlay();
        }
      }, 500);

      const rotations = { chill: 0, dance: 120, strange: 240 };
      const targetRotation = rotations[mode];
      modeKnob.style.transform = `rotate(${targetRotation}deg)`;
      modeKnob.dataset.rotation = targetRotation;
      
      modeKnob.style.transition = 'transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      
      if (window.updateKnobRotation) {
        window.updateKnobRotation(targetRotation);
      }
      
      setTimeout(() => {
        modeKnob.style.transition = '';
      }, 300);
      
      triggerTransitionEffects(mode);
    }

    // Update hero content based on mode
    function updateContent(mode) {
      const content = {
        chill: {
          title: 'Chill Vibes',
          titlePlayful: 'Chill',
          subtitle: 'Down-tempo textures and skeletal melodies for deep headspace.',
          section: 'Chill Vibes',
          description: 'Stripped-back studio captures where the room noise is as intentional as the notes. Minimalist energy for quiet focus.',
            bioTitle: 'CHILL MODE',
            bioText: 'At six, Taiwo learned piano by eavesdropping on siblings\' lessons through the wall, the notes absorbed through osmosis. Classical training felt like constraint until his father\'s wisdom reframed it: rules aren\'t walls, they\'re launch pads. Chill is the bedrock state. Simple arrangements where negative space does the work. Studio recordings that refuse polish because the imperfections are part of the story. This is where the instrument and the body become the same thing—breath control, string tension, the physics of vibration translated through tone.',
            image: '/sounds-and-bytes/images/Taiwo Heard InstaBub1.JPG'
        },
        dance: {
          title: 'Dance Party',
          titlePlayful: 'Dance',
          subtitle: 'Kinetic rhythms and driving synths for the high-velocity moments.',
          section: 'Big Dance Energy',
          description: 'High-powered visual loops over driving basslines. Constant motion, no friction, pure momentum.',
            bioTitle: 'DANCE MODE',
            bioText: 'Moving to LA meant joining a sonic ecosystem—bands, producers, the exchange of energy in real time. Playing live taught him arrangement as conversation; producing others taught him listening as technology. At Universal, Taiwo learned to think in algorithms: what characteristics make a song undeniable? Dance mode is fluidity—tracks that adapt, morph, refuse to stay still. Electronic pioneers like Brian Eno showed him sound could be sculptural. Now it\'s about momentum: building basslines that move bodies, beats that don\'t ask permission. Indie rock  music, composition, video game soundtracks—all have asked the same question: how quickly can you get people into the groove?',
            image: '/sounds-and-bytes/images/Taiwo Heard InstaBub2.JPG'
        },
        strange: {
          title: 'Strange Worlds',
          titlePlayful: 'Strange',
          subtitle: 'Sonic anomalies and fragmented frequencies from the outer edges.',
          section: 'Strange Dimensions',
          description: 'A collection of glitches, abstract layers, and sensory detours. For when you need the music to feel like a destination you\'ve never visited.',
            bioTitle: 'STRANGE MODE ',
            bioText: 'Strange is where boundaries evaporate. Coding meets composition. Taiwo\'s ear can reverse-engineer pop songs near instantly, but the real skill is *reconstruction*—taking apart the familiar to reveal its alien skeleton. Strange mode rejects categories. It\'s chiptune soundtracks over psychedelic visuals. It\'s using AI  to better understand music\'s emotional architecture. It\'s treating some projects like a controlled detonation: see what survives, keep the shrapnel.',
            image: '/sounds-and-bytes/images/Taiwo Heard Laugh.JPG'
        }
      };
      
      heroTitle.innerHTML = `<span class="playful">${content[mode].titlePlayful}</span> ${content[mode].title.replace(content[mode].titlePlayful, '').trim()}`;
      heroSubtitle.textContent = content[mode].subtitle;
      sectionTitle.textContent = content[mode].section;
      sectionDescription.textContent = content[mode].description;

      const modeImage = document.getElementById('modeImage');
      if (modeImage) {
        modeImage.src = content[mode].image;
      }

      const bioTitle = document.getElementById('bioTitle');
      const bioText = document.getElementById('bioText');
      if (bioTitle && bioText) {
        bioTitle.textContent = content[mode].bioTitle;
        bioText.textContent = content[mode].bioText;
      }
    }

    // Update video grid layout and content
    function updateVideoGrid(mode) {
      const allCards = document.querySelectorAll('.video-card');
      allCards.forEach(card => {
        if (card.dataset.mode === mode) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    function setupVideoGridEvents() {
      const cards = document.querySelectorAll('.video-card');
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const video = {
            id: card.dataset.videoId,
            title: card.dataset.videoTitle,
            description: card.dataset.videoDescription
          };
          openVideoModal(video);
        });
      });
    }

    // Setup video modal functionality
    function setupVideoModal() {
      modalCloseBtn.addEventListener('click', closeVideoModal);
      
      videoModal.addEventListener('click', (e) => {
        if (e.target === videoModal) {
          closeVideoModal();
        }
      });
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && videoModal.classList.contains('active')) {
          closeVideoModal();
        }
      });
    }

    // Open video in modal
    function openVideoModal(video) {
      const frame = document.getElementById('modalVideoFrame');
      modalVideoTitle.textContent = video.title;
      modalVideoDescription.textContent = video.description;
      
      const embedUrl = `/sounds-and-bytes/embed.html?id=${video.id}`; 
      if (frame) frame.src = embedUrl;
      
      videoModal.classList.add('active');
      
      document.body.style.overflow = 'hidden';
      
      toggleBackgroundVideos(false);
      
      if (isPlaying) {
        audioPlayer.pause();
        updatePlayPauseUI(false);
        isPlaying = false;
      }
    }

    // Close video modal
    function closeVideoModal() {
      videoModal.classList.remove('active');
      
      const frame = document.getElementById('modalVideoFrame');
      if (frame) {
        // Aggressively stop the video for Firefox and other browsers
        // by resetting the src and replacing the element entirely
        frame.src = 'about:blank';
        const newFrame = frame.cloneNode(true);
        newFrame.src = 'about:blank';
        frame.parentNode.replaceChild(newFrame, frame);
      }
      
      document.body.style.overflow = '';

      toggleBackgroundVideos(true);
    }

    // Setup music player functionality
    function setupMusicPlayer() {
      playBtn.addEventListener('click', togglePlay);
      prevBtn.addEventListener('click', () => previousTrack(true));
      nextBtn.addEventListener('click', () => nextTrack(true));
      shuffleBtn.addEventListener('click', toggleShuffle);
      
      progressBar.addEventListener('click', (e) => {
        const rect = progressBar.getBoundingClientRect();
        const percent = (e.clientX - rect.left) / rect.width;
        audioPlayer.currentTime = percent * audioPlayer.duration;
      });
      
      audioPlayer.addEventListener('timeupdate', updateProgress);
      audioPlayer.addEventListener('loadedmetadata', updateDuration);
      audioPlayer.addEventListener('ended', () => nextTrack(false));
    }

    // Load playlist for current mode
    function loadPlaylist(mode) {
      currentPlaylist = [...musicData[mode]];
      if (isShuffled) {
        shuffleArray(currentPlaylist);
      }
      currentTrackIndex = 0;
      loadTrack(currentTrackIndex, false);
    }

    // Load specific track
    function loadTrack(index, forcePlay = false) {
      if (!currentPlaylist[index]) return;

      const track = currentPlaylist[index];
      const wasPlaying = isPlaying;

      audioPlayer.src = track.file;
      trackTitle.textContent = track.title;
      trackArtist.textContent = track.artist;

      progressFill.style.width = '0%';
      currentTime.textContent = '0:00';
      duration.textContent = '0:00';

      audioPlayer.addEventListener('loadedmetadata', function onLoaded() {
        duration.textContent = formatTime(audioPlayer.duration);
        audioPlayer.removeEventListener('loadedmetadata', onLoaded);

        if (forcePlay || (wasPlaying && autoplayEnabled)) {
          setTimeout(() => attemptAutoPlay(true), 50);
        } else if (wasPlaying && !autoplayEnabled) {
          isPlaying = false;
          updatePlayPauseUI(false);
          audioPlayer.pause();
        }
      });
    }

    // SVG Icon Paths
    const playIconPath = "M8 5V19L19 12L8 5Z";
    const pauseIconPath = "M6 19H10V5H6V19ZM14 5V19H18V5H14Z";

    function updatePlayPauseUI(playing) {
      const playIcon = document.getElementById('playIcon');
      if (playIcon) {
        const path = playIcon.querySelector('path');
        path.setAttribute('d', playing ? pauseIconPath : playIconPath);
        playBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      }
    }

    // Attempt to auto-play
    function attemptAutoPlay(force = false) {
      if (!audioPlayer.src) return;

      if (!autoplayEnabled && !force) {
        console.log('Autoplay prevented by user preference');
        return;
      }

      const playPromise = audioPlayer.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          updatePlayPauseUI(true);
          isPlaying = true;
          document.querySelector('.music-player').classList.remove('autoplay-blocked');
          console.log('Auto-play successful');
        }).catch(error => {
          console.log('Auto-play prevented:', error);
          updatePlayPauseUI(false);
          isPlaying = false;
          document.querySelector('.music-player').classList.add('autoplay-blocked');
          setTimeout(() => {
            document.querySelector('.music-player').classList.remove('autoplay-blocked');
          }, 3000);
        });
      }
    }

    // Toggle play/pause
    function togglePlay() {
      if (isPlaying) {
        audioPlayer.pause();
        updatePlayPauseUI(false);
        isPlaying = false;
      } else {
        const playPromise = audioPlayer.play();
        if (playPromise !== undefined) {
          playPromise.then(() => {
            updatePlayPauseUI(true);
            isPlaying = true;
            document.querySelector('.music-player').classList.remove('autoplay-blocked');
          }).catch(error => {
            console.log('Audio play prevented:', error);
            updatePlayPauseUI(false);
            isPlaying = false;
          });
        }
      }
    }

    // Next track
    function nextTrack(forcePlay = false) {
      currentTrackIndex = (currentTrackIndex + 1) % currentPlaylist.length;
      loadTrack(currentTrackIndex, forcePlay);
    }

    // Previous track
    function previousTrack(forcePlay = false) {
      currentTrackIndex = currentTrackIndex === 0 ? currentPlaylist.length - 1 : currentTrackIndex - 1;
      loadTrack(currentTrackIndex, forcePlay);
    }

    // Toggle shuffle
    function toggleShuffle() {
      isShuffled = !isShuffled;
      shuffleBtn.classList.toggle('active', isShuffled);

      if (isShuffled) {
        shuffleArray(currentPlaylist);
      } else {
        currentPlaylist = [...musicData[currentMode]];
      }

      currentTrackIndex = 0;
      loadTrack(currentTrackIndex);
    }

    // Shuffle array utility
    function shuffleArray(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
    }

    // Update progress bar
    function updateProgress() {
      if (audioPlayer.duration) {
        const percent = (audioPlayer.currentTime / audioPlayer.duration) * 100;
        progressFill.style.width = percent + '%';
        currentTime.textContent = formatTime(audioPlayer.currentTime);
      }
    }

    // Update duration display
    function updateDuration() {
      duration.textContent = formatTime(audioPlayer.duration);
    }

    // Format time utility
    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    }

    // Trigger transition effects
    function triggerTransitionEffects(mode) {
      const flash = document.createElement('div');
      flash.style.cssText = `
        position: fixed;
        inset: 0;
        background: var(--current-accent);
        opacity: 0.10;
        z-index: 1000;
        pointer-events: none;
        animation: flash 0.2s ease-out;
      `;

      const flashKeyframes = `
        @keyframes flash {
          0% { opacity: 0; }
          50% { opacity: 0.15; }
          100% { opacity: 0; }
        }
      `;

      if (!document.querySelector('#flash-styles')) {
        const style = document.createElement('style');
        style.id = 'flash-styles';
        style.textContent = flashKeyframes;
        document.head.appendChild(style);
      }

      document.body.appendChild(flash);
      setTimeout(() => flash.remove(), 200);
    }

    // Update background videos based on theme
    function updateBackgroundVideos(mode) {
        const allVideos = document.querySelectorAll('.theme-background');
        const allVideoElements = document.querySelectorAll('.theme-background video');
        const allFallbacks = document.querySelectorAll('.video-fallback');

        // Pause all videos and hide fallbacks
        allVideoElements.forEach(video => {
          video.pause();
          video.style.opacity = '0';
        });

        allFallbacks.forEach(fallback => {
          fallback.style.opacity = '0';
        });

        allVideos.forEach(bg => {
          bg.classList.remove('active');
        });

        const activeVideo = document.querySelector(`.theme-background.${mode}-bg`);
        const activeVideoElement = activeVideo?.querySelector('video');
        const activeFallback = activeVideo?.querySelector('.video-fallback');

        if (activeVideo && activeVideoElement && activeFallback) {
          activeVideo.classList.add('active');

          // Try to play the video
          const playPromise = activeVideoElement.play();
          if (playPromise !== undefined) {
            playPromise.then(() => {
              // Video started successfully
              console.log('Video autoplay successful for mode:', mode);
              activeVideoElement.style.opacity = '1';
              activeFallback.style.opacity = '0';
              activeVideoElement.playbackRate = 0.7;
            }).catch(error => {
              // Video autoplay failed, show fallback
              console.log('Video autoplay prevented for mode:', mode, error);
              activeVideoElement.style.opacity = '0';
              activeFallback.style.opacity = '1';

              // Add click listener to try playing on user interaction
              const tryPlayOnClick = () => {
                activeVideoElement.play().then(() => {
                  activeVideoElement.style.opacity = '1';
                  activeFallback.style.opacity = '0';
                  activeVideoElement.playbackRate = 0.7;
                  document.removeEventListener('click', tryPlayOnClick);
                }).catch(() => {
                  // Still can't play, keep fallback
                  console.log('Video still cannot autoplay after user interaction');
                });
              };

              document.addEventListener('click', tryPlayOnClick, { once: true });
            });
          } else {
            // Browser doesn't support promises, fallback to basic handling
            setTimeout(() => {
              if (activeVideoElement.paused) {
                activeFallback.style.opacity = '1';
              } else {
                activeVideoElement.style.opacity = '1';
              }
            }, 100);
          }
        }
    }

    // Setup parallax effects
    function setupParallax() {
      let ticking = false;
      
      function updateParallax() {
        const scrolled = window.pageYOffset;
        const rate = scrolled * -0.5;
        
        document.getElementById('particles').style.transform = `translateY(${rate}px)`;
        
        ticking = false;
      }
      
      function requestTick() {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }
      
      window.addEventListener('scroll', requestTick, { passive: true });
    }

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', init);

    // Respect reduced motion preferences
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('*').forEach(el => {
        el.style.animationDuration = '0.01ms';
        el.style.animationIterationCount = '1';
        el.style.transitionDuration = '0.01ms';
      });
    }
  </script>
</BaseLayout>
