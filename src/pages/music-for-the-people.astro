---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

const videoData = {
  chill: [
    { 
      id: 'XaT_Ix7_7Nw', 
      title: 'I Cling to the Light', 
      description: "Singing 'I Cling to the light' in the studio",
      thumbnail: 'https://img.youtube.com/vi/XaT_Ix7_7Nw/maxresdefault.jpg'
    },
    { 
      id: '5T7xmYwTE7Y', 
      title: 'Good Other', 
      description: "Singing 'Good Other' in the studio",
      thumbnail: 'https://img.youtube.com/vi/5T7xmYwTE7Y/maxresdefault.jpg'
    },
    { 
      id: 'EJNbNBYgnRc', 
      title: 'Hearts in the Wild', 
      description: "Singing 'Hearts in the wild' in the studio",
      thumbnail: 'https://img.youtube.com/vi/EJNbNBYgnRc/maxresdefault.jpg'
    }
  ],
  dance: [
    { 
      id: 'O7joIkQtK68', 
      title: 'Avalon', 
      description: 'Dance rock vibes, feel the rush.',
      thumbnail: 'https://img.youtube.com/vi/O7joIkQtK68/maxresdefault.jpg'
    },
    { 
      id: 'bQMoUaI4RYg', 
      title: 'Treasure FreqSmasher Dance Remix', 
      description: 'Dance remix time! Party in a tunnel.',
      thumbnail: 'https://img.youtube.com/vi/bQMoUaI4RYg/maxresdefault.jpg'
    },
    { 
      id: 'MVnWxgzOTHY', 
      title: 'Cyclone FreqSmasher Dance Remix', 
      description: 'Freqsmasher re-imagines "Cyclone" with a tropical dance pop vibe.',
      thumbnail: 'https://img.youtube.com/vi/MVnWxgzOTHY/maxresdefault.jpg'
    }
  ],
  strange: [
    { 
      id: 'KlZfX4FIyug', 
      title: 'Desert Bus', 
      description: 'Classic 8-bit video game Desert Bus with chiptune from Taiwo',
      thumbnail: 'https://img.youtube.com/vi/KlZfX4FIyug/maxresdefault.jpg'
    },
    { 
      id: 'o7A5cuqUE3E', 
      title: 'Gaming Sketches', 
      description: 'Psychedelic Visualizations over fast paced video game music',
      thumbnail: 'https://img.youtube.com/vi/o7A5cuqUE3E/maxresdefault.jpg'
    },
    { 
      id: 'kT_O3uBtIVk', 
      title: 'Testing Baby Synths', 
      description: 'Me and my buddy Wolfgang Dilla testing out some mini synthesizers.',
      thumbnail: 'https://img.youtube.com/vi/kT_O3uBtIVk/maxresdefault.jpg'
    },
    { 
      id: 'sFJKBz8b26U', 
      title: 'Synth Jam with Wolfgang Dilla', 
      description: "A warm and fuzzy jam session with my pal Wolfgang Dilla, man's got synths for days.",
      thumbnail: 'https://img.youtube.com/vi/sFJKBz8b26U/maxresdefault.jpg'
    }
  ]
};
---

<BaseLayout
  title="Music for the People · A Morphing Experience"
  description="An immersive web experience where music and visuals transform across three distinct moods: Chill, Dance Party, and Strange."
>
  <style slot="head">
    /* CSS Custom Properties for Dynamic Theming */
    :root {
      /* Index.html Color Scheme */
      --bg-dark: #050505;
      --card-bg: #121212;
      --text-main: #ffffff;
      --text-muted: #888888;
      --accent-primary: #ff6b6b;
      --accent-secondary: #ffd93d;
      --accent-tertiary: #6bffb8;
      --accent-playful: #7ec4ff;
      --accent-playful2: #ffb3ec;
      --font-heading: 'Outfit', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-playful: 'Fredoka', sans-serif;
      --gradient-main: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
      
      /* Chill Theme */
      --chill-primary: #6366f1;
      --chill-secondary: #a855f7;
      --chill-accent: #06b6d4;
      --chill-bg-start: #0f0f23;
      --chill-bg-end: #1e1b4b;
      --chill-text: #e2e8f0;
      --chill-text-soft: #94a3b8;
      
      /* Dance Party Theme */
      --dance-primary: #fbbf24;
      --dance-secondary: #f59e0b;
      --dance-accent: #10b981;
      --dance-bg-start: #000000;
      --dance-bg-end: #111111;
      --dance-text: #fbbf24;
      --dance-text-soft: #fde047;
      
      /* Strange Theme */
      --strange-primary: #8b5cf6;
      --strange-secondary: #06ffa5;
      --strange-accent: #ff006e;
      --strange-bg-start: #1a0033;
      --strange-bg-end: #004d00;
      --strange-text: #00ff88;
      --strange-text-soft: #ff0080;
      
      /* Current Theme Variables */
      --current-primary: var(--chill-primary);
      --current-secondary: var(--chill-secondary);
      --current-accent: var(--chill-accent);
      --current-bg-start: var(--chill-bg-start);
      --current-bg-end: var(--chill-bg-end);
      --current-text: var(--chill-text);
      --current-text-soft: var(--chill-text-soft);
      
      /* Layout */
      --container-max: 1400px;
      --gutter: clamp(16px, 3vw, 32px);
      --border-radius: 16px;
      --shadow-soft: 0 10px 40px rgba(0,0,0,0.3);
      --transition-smooth: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      --transition-quick: all 0.3s ease-out;
    }

    /* Base Styles */
    body {
      background: linear-gradient(135deg, var(--current-bg-start), var(--current-bg-end));
      transition: var(--transition-smooth);
    }

    /* Dynamic Theme Background Videos */
    .theme-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      opacity: 0;
      transition: opacity 1.5s ease-in-out;
    }
    
    .theme-background video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(1px);
    }

    .video-fallback {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      filter: blur(1px);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.8s ease-in-out;
    }

    .theme-background.active {
      opacity: 0.2;
    }
    
    /* Chill theme - Tunnel video for flow state */
    .theme-chill .theme-background.chill-bg {
      opacity: 0.15;
    }
    
    /* Dance theme - Disco ball energy */
    .theme-dance .theme-background.dance-bg {
      opacity: 0.25;
    }
    
    /* Strange theme - Astronaut surreal vibes */
    .theme-strange .theme-background.strange-bg {
      opacity: 0.2;
    }
    
    /* Reduce motion for accessibility */
    @media (prefers-reduced-motion: reduce) {
      .theme-background video {
        animation-play-state: paused;
      }
      .theme-background {
        opacity: 0.1 !important;
      }
    }

    /* Animated Background Particles */
    .particles {
      position: fixed;
      inset: 0;
      z-index: -1;
      opacity: 0.4;
      pointer-events: none;
    }
    
    .particle {
      position: absolute;
      width: 2px;
      height: 2px;
      background: var(--current-accent);
      border-radius: 50%;
      animation: float 20s infinite linear;
      transition: var(--transition-smooth);
    }
    
    /* Disco Ball Mirror Particles for Dance Mode */
    .theme-dance .particle {
      background: linear-gradient(45deg, #ffd700, #ffffff, #ffd700);
      box-shadow: 
        0 0 4px rgba(255, 215, 0, 0.8),
        0 0 8px rgba(255, 255, 255, 0.4);
      animation: float 20s infinite linear, mirror-flash 2s infinite;
    }
    
    @keyframes mirror-flash {
      0%, 50%, 100% { 
        opacity: 0.6;
        transform: scale(1);
      }
      25% { 
        opacity: 1;
        transform: scale(1.5);
        box-shadow: 
          0 0 8px rgba(255, 215, 0, 1),
          0 0 16px rgba(255, 255, 255, 0.8);
      }
      75% { 
        opacity: 1;
        transform: scale(1.2);
        box-shadow: 
          0 0 6px rgba(255, 215, 0, 0.9),
          0 0 12px rgba(255, 255, 255, 0.6);
      }
    }
    
    @keyframes float {
      0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { transform: translateY(-100vh) rotate(360deg); opacity: 0; }
    }

    /* Mode Selector Knob */
    .mode-selector {
      position: fixed;
      top: 50%;
      right: 2rem;
      transform: translateY(-50%);
      z-index: 50;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    
    .knob-container {
      position: relative;
      width: 120px;
      height: 120px;
    }
    
    .knob {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: 
        conic-gradient(from 0deg, 
          var(--current-primary) 0deg 120deg,
          var(--current-secondary) 120deg 240deg,
          var(--current-accent) 240deg 360deg
        );
      border: 4px solid rgba(255,255,255,0.2);
      cursor: pointer;
      transition: var(--transition-smooth);
      position: relative;
      box-shadow: var(--shadow-soft);
      user-select: none;
    }
    
    .knob:hover {
      transform: scale(1.05);
      box-shadow: 0 0 30px var(--current-accent);
    }
    
    .knob:active {
      transform: scale(0.95);
    }
    
    .knob::after {
      content: '';
      position: absolute;
      top: 10%;
      left: 50%;
      transform: translateX(-50%);
      width: 4px;
      height: 20px;
      background: #fff;
      border-radius: 2px;
      box-shadow: 0 0 10px rgba(255,255,255,0.8);
      transition: var(--transition-quick);
    }
    
    .knob.rotating {
      transform: scale(1.1);
      box-shadow: 0 0 30px var(--current-accent);
    }
    
    .mode-labels {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      font-size: 0.8rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    
    .mode-label {
      opacity: 0.6;
      transition: var(--transition-quick);
      cursor: pointer;
    }
    
    .mode-label.active {
      opacity: 1;
      color: var(--current-accent);
      font-weight: 600;
      text-shadow: 0 0 10px currentColor;
    }

    /* Hero Section */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 2rem var(--gutter);
      position: relative;
      overflow: hidden;
    }
    
    .hero-bg {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: radial-gradient(circle at 50% 50%, rgba(255, 107, 107, 0.15), transparent 60%),
                  radial-gradient(circle at 80% 20%, rgba(255, 217, 61, 0.1), transparent 40%);
      z-index: 1;
    }
    .hero-svg-waves {
      position: absolute;
      bottom: -10px;
      left: 0;
      width: 130%;
      height: 180px;
      z-index: 2;
      pointer-events: none;
      opacity: 0.85;
    }
    .hero-svg-waves svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    @keyframes waveMove {
      0% { transform: translateX(0); }
      100% { transform: translateX(-60px); }
    }
    .hero-svg-waves .wave1 {
      animation: waveMove 8s linear infinite alternate;
    }
    .hero-svg-waves .wave2 {
      animation: waveMove 12s linear infinite alternate-reverse;
    }
    
    .hero-content {
      position: relative;
      z-index: 3;
    }
    
    .hero h1 {
      font-family: var(--font-heading);
      font-size: clamp(3.5rem, 10vw, 9rem);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 0.9;
      text-transform: uppercase;
      margin: 0 0 1rem;
      background: linear-gradient(to right, #fff, #aaa);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      transition: var(--transition-smooth);
    }
    .hero h1 .playful {
      font-family: var(--font-playful);
      background: linear-gradient(90deg, var(--accent-playful2), var(--accent-playful), var(--accent-primary));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.01em;
      font-size: 1.1em;
      display: inline-block;
    }
    
    .hero p {
      font-family: var(--font-mono);
      font-size: clamp(1.1rem, 2.5vw, 1.8rem);
      color: var(--text-muted);
      max-width: 600px;
      line-height: 1.6;
      margin-bottom: 3rem;
      transition: var(--transition-smooth);
    }
    .scroll-indicator {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      animation: bounce 2s infinite;
      opacity: 0.5;
      z-index: 4;
    }
    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% {transform: translateY(0) translateX(-50%);}
      40% {transform: translateY(-10px) translateX(-50%);}
      60% {transform: translateY(-5px) translateX(-50%);}
    }

    /* Music Player - Sleek Modern Design */
    .music-player {
      position: fixed;
      bottom: 2rem;
      left: 2rem;
      z-index: 50;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(40px);
      -webkit-backdrop-filter: blur(40px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 1.25rem 2.5rem;
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.4),
        0 2px 8px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      min-width: 320px;
      max-width: 420px;
    }

    .music-player.autoplay-blocked {
      animation: pulse-glow 2s infinite;
      border-color: var(--current-accent);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.4),
        0 2px 8px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 0 20px rgba(255, 107, 107, 0.3);
    }

    @keyframes pulse-glow {
      0%, 100% {
        box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.4),
          0 2px 8px rgba(0, 0, 0, 0.2),
          inset 0 1px 0 rgba(255, 255, 255, 0.1),
          0 0 20px rgba(255, 107, 107, 0.2);
      }
      50% {
        box-shadow:
          0 8px 32px rgba(0, 0, 0, 0.4),
          0 2px 8px rgba(0, 0, 0, 0.2),
          inset 0 1px 0 rgba(255, 255, 255, 0.1),
          0 0 30px rgba(255, 107, 107, 0.5);
      }
    }

    .music-player:hover {
      background: rgba(0, 0, 0, 0.85);
      border-color: rgba(255, 255, 255, 0.15);
      transform: translateY(-5px);
      box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.5),
        0 4px 12px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
    
    .player-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .track-info h3 {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.95);
      transition: var(--transition-quick);
      letter-spacing: -0.01em;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    }

    .track-info p {
      margin: 0.25rem 0 0;
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.6);
      transition: var(--transition-quick);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-size: 0.7rem;
    }
    
    .player-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    
    .control-btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      color: var(--current-text);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .control-btn svg {
      width: 20px;
      height: 20px;
      display: block;
      transition: all 0.3s ease;
      position: relative;
      z-index: 2;
    }

    .control-btn.play-pause svg {
      width: 24px;
      height: 24px;
      color: #fff;
    }

    .control-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, var(--current-primary), var(--current-secondary));
      opacity: 0;
      transition: opacity 0.3s ease;
      border-radius: inherit;
    }

    .control-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.25);
      transform: translateY(-1px);
      box-shadow:
        0 6px 16px rgba(0, 0, 0, 0.3),
        0 0 25px var(--current-primary),
        0 0 40px var(--current-accent);
    }

    .control-btn:hover::before {
      opacity: 0.1;
    }

    .control-btn:active {
      transform: translateY(0);
      transition: transform 0.1s ease;
    }

    .control-btn.play-pause {
      width: 56px;
      height: 56px;
      background: linear-gradient(135deg, var(--current-accent), var(--current-secondary));
      border: none;
      border-radius: 16px;
      font-size: 1.3rem;
      margin: 0 0.5rem;
      box-shadow:
        0 4px 16px rgba(0, 0, 0, 0.3),
        0 2px 8px rgba(255, 107, 107, 0.3);
    }

    .control-btn.play-pause::before {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
    }

    .control-btn.play-pause:hover {
      background: linear-gradient(135deg, var(--current-accent), var(--current-secondary));
      box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.4),
        0 3px 12px rgba(255, 107, 107, 0.5);
      transform: translateY(-2px);
    }

    /* Navigation buttons styling */
    #prevBtn:hover::before {
      background: linear-gradient(135deg, var(--current-secondary), var(--current-primary));
      opacity: 0.08;
    }

    #nextBtn:hover::before {
      background: linear-gradient(135deg, var(--current-primary), var(--current-secondary));
      opacity: 0.08;
    }

    /* Shuffle button special styling */
    #shuffleBtn {
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    #shuffleBtn.active {
      background: linear-gradient(135deg, var(--current-accent), var(--current-secondary));
      border-color: var(--current-accent);
      box-shadow:
        0 4px 16px rgba(0, 0, 0, 0.3),
        0 0 20px var(--current-accent);
      transform: rotate(180deg);
    }

    #shuffleBtn.active:hover {
      background: linear-gradient(135deg, var(--current-accent), var(--current-secondary));
      box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.4),
        0 0 30px var(--current-accent);
      transform: rotate(180deg) translateY(-1px);
    }
    
      .progress-container {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 500;
        font-family: var(--font-mono);
        letter-spacing: 0.5px;
      }

    /* Mobile mood selector - only visible on mobile */
    .mobile-mood-selector {
      display: none; /* Hidden on desktop */
    }

    .mood-word {
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.7rem;
      font-weight: 400;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s ease;
      user-select: none;
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      opacity: 0.7;
    }

    .mood-word:hover {
      color: rgba(255, 255, 255, 0.8);
      background: rgba(255, 255, 255, 0.03);
      opacity: 1;
    }

    .mood-word.active {
      color: var(--current-accent);
      background: rgba(255, 255, 255, 0.08);
      font-weight: 500;
      opacity: 1;
    }

    .progress-bar {
      flex: 1;
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
      overflow: hidden;
      cursor: pointer;
      position: relative;
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.3s ease;
    }

    .progress-bar:hover {
      background: rgba(255, 255, 255, 0.15);
      height: 8px;
      border-radius: 4px;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--current-accent), var(--current-secondary));
      width: 0%;
      transition: width 0.2s ease;
      border-radius: inherit;
      position: relative;
    }

    .progress-fill::after {
      content: '';
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 2px;
      background: rgba(255, 255, 255, 0.8);
      border-radius: 1px;
    }

    /* Autoplay Toggle */
    .autoplay-toggle {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.3rem;
      font-size: 0.65rem;
      color: rgba(255, 255, 255, 0.6);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      transition: var(--transition-quick);
    }
    
    .autoplay-toggle:hover {
      color: rgba(255, 255, 255, 0.9);
    }
    
    .autoplay-toggle input {
      display: none;
    }
    
    .toggle-switch {
      width: 32px;
      height: 18px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      position: relative;
      transition: all 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .autoplay-toggle input:checked + .toggle-switch {
      background: var(--current-accent);
      border-color: var(--current-accent);
      box-shadow: 0 0 10px var(--current-accent);
    }
    
    .toggle-switch::after {
