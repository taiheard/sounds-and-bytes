---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Flow States: A Sensory Journey Through Music and Art" description="A guided journey designed to support relaxation through art, sound, and gentle breathing practices.">
    <style slot="head">
        :root {
            --accent: #ffd166;
            --panel-bg: rgba(10,10,20,0.45);
            --panel-stroke: rgba(255,255,255,0.08);
            --gutter: clamp(18px, 2.4vw, 34px);
            --container-max: 1500px;
        }

        .background {
            position: fixed;
            inset: 0;
            z-index: -2;
            background: linear-gradient(#0a0a1a, #0a0a1a);
        }

        
        

        .hero { 
            text-align: center; 
            padding: 0 2rem; 
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        .hero-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(255, 107, 107, 0.15), transparent 60%),
                        radial-gradient(circle at 80% 20%, rgba(255, 217, 61, 0.1), transparent 40%);
            z-index: 1;
        }
        .hero-svg-waves {
            position: absolute;
            bottom: -80px;
            left: -15%;
            width: 130%;
            height: 360px;
            z-index: 2;
            pointer-events: none;
            opacity: 0.6;
        }
        .hero-svg-waves svg {
            width: 100%;
            height: 100%;
            display: block;
        }
        @keyframes waveMove {
            0% { transform: translateX(0); }
            100% { transform: translateX(-30px); }
        }
        .hero-svg-waves .wave1 { animation: waveMove 12s linear infinite alternate; }
        .hero-svg-waves .wave2 { animation: waveMove 18s linear infinite alternate-reverse; }

        .hero h1 {
            font-family: var(--font-heading);
            font-weight: 900;
            font-size: clamp(3rem, 8vw, 7rem);
            line-height: 0.9;
            text-transform: uppercase;
            background: linear-gradient(to right, #fff, #aaa);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            position: relative;
            z-index: 3;
        }
        .hero h1 .playful {
            font-family: var(--font-playful);
            background: linear-gradient(90deg, var(--accent-playful2), var(--accent-playful), var(--accent-primary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .hero p {
            font-family: var(--font-mono);
            color: var(--text-muted);
            max-width: 1100px;
            margin: 4rem auto 2.2rem;
            line-height: 1.9;
            font-size: clamp(1.1rem, 1.9vw, 1.35rem);
            position: relative;
            z-index: 3;
        }
        .cta {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.8rem 1.8rem;
            border-radius: 50px;
            background: linear-gradient(135deg, var(--accent-playful) 0%, var(--accent-playful2) 100%);
            color: #000;
            font-weight: 700;
            font-family: var(--font-heading);
            font-size: 1.1rem;
            letter-spacing: 0.5px;
            position: relative;
            z-index: 3;
            text-decoration: none;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 4rem;
        }
        .cta::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 50px;
            background: linear-gradient(135deg, var(--accent-playful), var(--accent-playful2));
            opacity: 0;
            filter: blur(15px);
            z-index: -1;
            transform: scale(0.9);
        }
        .cta:hover { transform: translateY(-2px) scale(1.02); }
        .cta:hover::before { opacity: 0.6; }

        .cta.secondary {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .journey { max-width: var(--container-max); margin: 0 auto; padding: var(--gutter); }
        .chapter { position: relative; min-height: 120vh; display: grid; grid-template-columns: repeat(12, minmax(0,1fr)); gap: var(--gutter); align-items: start; margin: 10vh 0; padding: var(--gutter); }
        .chapter-header { grid-column: 2 / span 5; z-index: 2; margin-top: 10vh; opacity: 0.95; }
        .kicker { color: var(--accent); letter-spacing: 3px; text-transform: uppercase; font-weight: 600; font-size: 0.8rem; }
        .chapter-header h2 { font-weight: 200; letter-spacing: 4px; margin: .25rem 0 0; font-size: clamp(1.8rem, 4.2vw, 2.6rem); }
        .chapter-media { grid-column: 1 / -1; position: sticky; top: 0; height: 100vh; z-index: 1; }
        .chapter-content { grid-column: 2 / span 5; padding: 1.6rem 1.7rem; align-self: start; max-width: 72ch; z-index: 2; margin-top: 2vh; background: rgba(10,10,20,0.55); border: 1px solid var(--panel-stroke); backdrop-filter: blur(8px); border-radius: 14px; }
        .chapter:nth-child(even) .chapter-header { grid-column: 7 / span 5; }
        .chapter:nth-child(even) .chapter-content { grid-column: 7 / span 5; }
        
        .media-frame { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: calc(100vh * 16 / 9); height: 100vh; }
        @media (min-aspect-ratio: 16/9) { .media-frame { width: 100vw; height: calc(100vw * 9 / 16); } }
        
        .story { color: #f0edf8; line-height: 2.05; margin-bottom: 1.35rem; font-size: clamp(1.28rem, 2.15vw, 1.65rem); }
        .practice { color: #e9dcff; line-height: 1.8; background: rgba(255,255,255,0.06); border: 1px solid var(--panel-stroke); padding: 1.5rem 1.75rem; border-radius: 14px; font-size: clamp(1.1rem, 1.8vw, 1.35rem); }
        .practice-list { list-style: none; padding: 0; margin-top: 0.5rem; font-size: 0.85em; }
        .practice-list li { position: relative; padding-left: 1.4rem; margin-bottom: 0.6rem; }
        .practice-list li::before { content: "•"; position: absolute; left: 0; color: var(--accent); }

        .play-button { 
            position: relative; 
            z-index: 2; 
            display: flex; 
            flex-direction: column;
            align-items: center; 
            gap: 1rem; 
            padding: 2rem;
            transition: all 0.4s ease;
        }
        .play-circle {
            width: 80px; height: 80px; border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            display: flex; align-items: center; justify-content: center;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 0 0 0 rgba(255,255,255,0);
        }
        .play-icon { 
            width: 0; height: 0; 
            border-left: 20px solid #ffffff; 
            border-top: 12px solid transparent; 
            border-bottom: 12px solid transparent; 
            margin-left: 6px;
            filter: drop-shadow(0 0 10px rgba(255,255,255,0.4));
        }
        .play-text { 
            font-family: var(--font-mono); 
            font-size: 0.8rem; 
            letter-spacing: 4px; 
            text-transform: uppercase; 
            color: #fff; 
            opacity: 0.6; 
            transition: all 0.4s ease;
        }
        .video-proxy:hover .play-circle {
            transform: scale(1.1);
            background: rgba(255, 255, 255, 0.2);
            border-color: #fff;
            box-shadow: 0 0 30px rgba(255,255,255,0.2);
        }
        .video-proxy:hover .play-text {
            opacity: 1;
            letter-spacing: 6px;
        }

        .progress { position: fixed; right: 14px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 8px; z-index: 9; }
        .dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.35); cursor: pointer; }
        .dot.active { background: #ffffff; transform: scale(1.4); }

        .reveal { opacity: 0; transform: translateY(20px); transition: opacity 1000ms ease, transform 1000ms ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        @media (max-width: 980px) {
            .hero {
                padding-top: 6rem;
                min-height: auto;
                padding-bottom: 4rem;
            }
            .hero h1 {
                font-size: clamp(2.5rem, 10vw, 4rem);
            }
            .hero p {
                margin: 2rem auto;
                font-size: 1.1rem;
            }
            .cta {
                margin-top: 2rem;
            }
            .chapter { 
                grid-template-columns: 1fr; 
                min-height: auto; 
                margin: 4rem 0;
                padding: 1rem;
            }
            .chapter-header { 
                grid-column: 1 / -1; 
                margin-top: 2rem;
                text-align: center;
            }
            .chapter-media { 
                grid-column: 1 / -1; 
                height: 30vh; 
                position: relative; 
                order: -1;
            }
            .chapter-content { 
                grid-column: 1 / -1; 
                margin-top: 1rem;
                padding: 1.5rem;
            }
            .story {
                font-size: 1.15rem;
                line-height: 1.7;
                margin-bottom: 1.5rem;
            }
            .practice {
                font-size: 1rem;
                line-height: 1.6;
                padding: 1.25rem;
            }
            .media-frame { 
                width: calc(30vh * 16 / 9); 
                height: 30vh; 
            }
            .progress { display: none; }
            .chapter:nth-child(even) .chapter-header,
            .chapter:nth-child(even) .chapter-content {
                grid-column: 1 / -1;
            }
            .end-screen-buttons {
                justify-content: center;
            }
        }
    </style>


    <div class="background" aria-hidden="true"></div>

    <section class="hero">
        <div class="hero-bg"></div>
        <div class="hero-svg-waves">
            <svg viewBox="0 0 2000 200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path class="wave1" d="M0,100 Q200,40 400,100 T800,100 T1200,100 T1600,100 T2000,100 L2000,100 Q1800,160 1600,100 T1200,100 T800,100 T400,100 T0,100 Z" fill="#7ec4ff" fill-opacity="0.2"/>
                <path class="wave2" d="M0,100 Q100,160 200,100 T400,100 T600,100 T800,100 T1000,100 T1200,100 T1400,100 T1600,100 T1800,100 T2000,100 L2000,100 Q1900,40 1800,100 T1600,100 T1400,100 T1200,100 T1000,100 T800,100 T600,100 T400,100 T200,100 T0,100 Z" fill="#ffb3ec" fill-opacity="0.15"/>
                <path d="M0,100 Q400,70 800,100 T1600,100 T2000,100 L2000,100 Q1800,130 1600,100 T800,100 T0,100 Z" fill="#ffd93d" fill-opacity="0.12"/>
            </svg>
        </div>
        <h1>Finding the <span class="playful">Signal Home</span></h1>
        <p>A cinematic scrolling story experience— gentle breathing and wellness practices designed for deep calm. It's an immersive narrative journey that uses art, lofi ambience, and breathing techniques to guide you from restlessness to rest.</p>
        <a class="cta" href="#c1">Begin Journey ↓</a>
    </section>

    <nav class="progress" aria-label="Progress navigation">
        <span class="dot" data-target="#c1" aria-label="The Fog"></span>
        <span class="dot" data-target="#c2" aria-label="The Visitor"></span>
        <span class="dot" data-target="#c5" aria-label="The Waterfall’s Lesson"></span>
        <span class="dot" data-target="#c10" aria-label="The Shore You Carry"></span>
        <span class="dot" data-target="#end-screen" aria-label="End Screen"></span>
    </nav>

    <main class="journey">
        <article id="c1" class="chapter reveal">
            <div class="chapter-header"><span class="kicker">Scene One</span><h2>1 · The Fog</h2></div>
            <div class="chapter-media">
                <div class="media-frame">
                    <div class="video-proxy" data-yt="4wfM8mfFYIk" data-thumb="/sounds-and-bytes/images/flow state thumbs/the fog.jpeg">
                        <div class="video-thumb" aria-hidden="true"></div>
                        <div class="play-button">
                            <div class="play-circle"><span class="play-icon"></span></div>
                            <span class="play-text"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="chapter-content">
                <p class="story">You wake in a quiet, mist-laden forest. Everything feels unfamiliar, but the breath you carry is still yours. The air is cool, the light is soft, and you're not quite sure how you arrived here—but something tells you this is exactly where you need to be.</p>
                <p class="practice">
                    <strong>Practice: 3 breaths to arrive</strong><br>
                    Inhale for 4 counts, hold for 2, exhale for 6. As you breathe, notice three things you see, two you hear, one you feel. This simple act pulls you from rumination into presence.
                </p>
            </div>
        </article>

        <article id="c2" class="chapter reveal">
            <div class="chapter-header"><span class="kicker">Scene Two</span><h2>2 · The Visitor</h2></div>
            <div class="chapter-media">
                <div class="media-frame">
                    <div class="video-proxy" data-yt="EgUlfdSaX7o" data-thumb="/sounds-and-bytes/images/flow state thumbs/Forest Pool.jpeg">
                        <div class="video-thumb"></div>
                        <div class="play-button">
                            <div class="play-circle"><span class="play-icon"></span></div>
                            <span class="play-text"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="chapter-content">
                <p class="story">By an abandoned pool reclaimed by moss and grass, a lone astronaut sits—homesick, unsure. The real insight: you realize you're not alone in feeling alone. Sometimes the most profound connection comes from recognizing shared struggle.</p>
                <p class="practice"><strong>Practice: Name it to tame it</strong> <br> Whisper one word for what you feel. Place a hand on your chest; say aloud: <strong>"This is hard, but others feel this too."</strong> Many find that simply naming an emotion can help reduce its intensity—a concept often referred to as "affect labeling."</p>
            </div>
        </article>

        <article id="c5" class="chapter reveal">
            <div class="chapter-header"><span class="kicker">Scene Three</span><h2>3 · The Waterfall’s Lesson</h2></div>
            <div class="chapter-media">
                <div class="media-frame">
                    <div class="video-proxy" data-yt="WvX4oeypIww" data-thumb="/sounds-and-bytes/images/flow state thumbs/Mystic Falls.jpeg">
                        <div class="video-thumb"></div>
                        <div class="play-button">
                            <div class="play-circle"><span class="play-icon"></span></div>
                            <span class="play-text"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="chapter-content">
                <p class="story">A purple-leafed canopy opens; the falls thunder and soothe. Here's the paradox: release doesn't require permission—only patience and time. The water doesn't force its way down; it simply follows the path of least resistance.</p>
                <div class="practice">
                    <strong>Practice: RAIN for Release</strong>
                    <ul class="practice-list">
                        <li><strong>Recognize</strong> one stress (name it specifically) without getting lost in the feeling.</li>
                        <li><strong>Allow</strong> it without resistance, judgment, or trying to change it.</li>
                        <li><strong>Investigate</strong> with kindness (where do you feel it in your body?)</li>
                        <li><strong>Nurture</strong> with a gentle phrase ("I will be kind to myself today.")</li>
                    </ul>
                    <p style="margin-top: 1rem; font-size: 0.8em; opacity: 0.8; line-height: 1.4; text-wrap: pretty;">
                        This is adapted from RAIN meditation—a widely recognized mindfulness technique used to help navigate difficult emotions.
                    </p>
                </div>
            </div>
        </article>

        <article id="c10" class="chapter reveal">
            <div class="chapter-header"><span class="kicker">Final Scene</span><h2>4 · The Shore You Carry</h2></div>
            <div class="chapter-media">
                <div class="media-frame">
                    <div class="video-proxy" data-yt="Veia2sjjIzQ" data-thumb="/sounds-and-bytes/images/flow state thumbs/beach scene.jpeg">
                        <div class="video-thumb"></div>
                        <div class="play-button">
                            <div class="play-circle"><span class="play-icon"></span></div>
                            <span class="play-text"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="chapter-content">
                <p class="story">As you leave, the forest does not hold you and the sea does not pull you. The real magic: the calm is traveling with you now, like a gentle tide within. You've learned that peace isn't a destination—it's a practice you carry.</p>
                <div class="practice">
                    <strong>Practice: Closing Ritual</strong>
                    <ul class="practice-list">
                        <li>One hand to heart, one to belly.</li>
                        <li>Inhale: <em>"I belong."</em></li>
                        <li>Exhale: <em>"I am enough."</em></li>
                        <li>Repeat three times.</li>
                    </ul>
                    <p style="margin-top: 1rem; font-size: 0.8em; opacity: 0.8; line-height: 1.4; text-wrap: pretty;">
                        This form of bilateral stimulation (engaging both sides of the body) is often used to encourage the body's natural relaxation response.
                    </p>
                </div>
            </div>
        </article>

        <article id="end-screen" class="chapter reveal">
            <div class="chapter-header">
                <span class="kicker">Reflection</span>
                <h2>The Signal Is Always There</h2>
            </div>
            <div class="chapter-content">
                <p class="story">Whenever you need to return, this journey will be here. The practices you've learned—breath work, naming emotions, RAIN meditation, bilateral grounding—these are tools you now carry with you.</p>
                <div class="end-screen-buttons" style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
                    <a href="#c1" class="cta">Restart Journey</a>
                    <a href="/sounds-and-bytes/" class="cta secondary">Explore More Projects</a>
                </div>
            </div>
        </article>

        <!-- Disclaimer Footer -->
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 2rem; opacity: 0.5; font-size: 0.75rem; color: var(--text-muted);">
            <p><em>Note: This experience is for creative and relaxation purposes only and is not intended as medical advice or treatment.</em></p>
        </div>
    </main>

    <script is:inline>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('visible');
                    observer.unobserve(e.target);
                }
            });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        const chapters = Array.from(document.querySelectorAll('.chapter'));
        const dots = Array.from(document.querySelectorAll('.dot'));
        function updateDots() {
            const viewportCenter = window.scrollY + window.innerHeight / 2;
            let activeIndex = 0;
            chapters.forEach((ch, i) => {
                const rect = ch.getBoundingClientRect();
                const chCenter = window.scrollY + rect.top + rect.height / 2;
                if (chCenter < viewportCenter) activeIndex = i;
            });
            dots.forEach((d, i) => d.classList.toggle('active', i === activeIndex));
        }
        updateDots();
        window.addEventListener('scroll', updateDots, { passive: true });
        dots.forEach(d => d.addEventListener('click', () => {
            const t = document.querySelector(d.getAttribute('data-target'));
            if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }));

        function buildThumbUrl(id) { return `https://img.youtube.com/vi/${id}/maxresdefault.jpg`; }
        function buildIframe(id) {
            // Validate YouTube video ID format (11 characters, alphanumeric + hyphens/underscores)
            const youtubeIdRegex = /^[a-zA-Z0-9_-]{11}$/;
            if (!youtubeIdRegex.test(id)) {
                console.error('Invalid YouTube video ID:', id);
                return document.createElement('div'); // Return empty div for invalid IDs
            }

            const src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
            const wrap = document.createElement('div');
            wrap.className = 'iframe-wrap';
            const iframe = document.createElement('iframe');
            iframe.setAttribute('allow', 'autoplay; encrypted-media; gyroscope; picture-in-picture');
            iframe.setAttribute('allowfullscreen', '');
            iframe.setAttribute('loading', 'lazy');
            iframe.src = src;
            iframe.style.width = '100%';
            iframe.style.height = '100%';
            iframe.style.border = 'none';
            wrap.appendChild(iframe);
            return wrap;
        }
        function loadThumb(el) {
            const localThumb = el.getAttribute('data-thumb');
            const thumb = el.querySelector('.video-thumb');
            if (localThumb) {
                thumb.style.backgroundImage = `url('${localThumb}')`;
            } else {
                const id = el.getAttribute('data-yt');
                const hi = new Image();
                const fallback = `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
                hi.src = buildThumbUrl(id);
                hi.onload = () => thumb.style.backgroundImage = `url('${hi.src}')`;
                hi.onerror = () => thumb.style.backgroundImage = `url('${fallback}')`;
            }
        }
        function enableProxy(el) {
            loadThumb(el);
            el.addEventListener('click', () => {
                // Stop all other playing videos first
                document.querySelectorAll('.iframe-wrap').forEach(wrap => {
                    if (wrap._proxy) {
                        wrap.parentElement.replaceChild(wrap._proxy, wrap);
                    }
                });

                const id = el.getAttribute('data-yt');
                const parent = el.parentElement;
                const iframeWrap = buildIframe(id);
                iframeWrap._proxy = el; // Store reference to restore later
                parent.replaceChild(iframeWrap, el);
            });
        }
        document.querySelectorAll('.video-proxy').forEach(enableProxy);

        // Keyboard navigation (← → to move between scenes)
        function gotoScene(idx) {
            const target = chapters[idx];
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        window.addEventListener('keydown', (e) => {
            if (['ArrowRight','PageDown'].includes(e.key)) {
                e.preventDefault();
                const active = dots.findIndex(d => d.classList.contains('active'));
                gotoScene(Math.min(chapters.length - 1, active + 1));
            }
            if (['ArrowLeft','PageUp'].includes(e.key)) {
                e.preventDefault();
                const active = dots.findIndex(d => d.classList.contains('active'));
                gotoScene(Math.max(0, active - 1));
            }
        });


        // Respect reduced motion
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('*').forEach(el => el.style.scrollBehavior = 'auto');
            document.querySelectorAll('.layer').forEach(l => l.style.animation = 'none');
        }
    </script>
</BaseLayout>









