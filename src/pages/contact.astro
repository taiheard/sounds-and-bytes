---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact - Taiwo Heard" description="Get in touch with Taiwo Heard for music and web projects.">
    <style slot="head">
        /* Background Effects */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, rgba(10, 10, 10, 0.9), rgba(26, 26, 26, 0.9));
            z-index: -1;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            text-align: center;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            padding: 0 2rem;
        }

        .hero-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(255, 107, 107, 0.15), transparent 60%),
                        radial-gradient(circle at 80% 20%, rgba(255, 217, 61, 0.1), transparent 40%);
            z-index: 1;
        }
        .hero-svg-waves {
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 130%;
            height: 180px;
            z-index: 2;
            pointer-events: none;
            opacity: 0.85;
        }
        .hero-svg-waves svg {
            width: 100%;
            height: 100%;
            display: block;
        }
        @keyframes waveMove {
            0% { transform: translateX(0); }
            100% { transform: translateX(-60px); }
        }
        .hero-svg-waves .wave1 {
            animation: waveMove 8s linear infinite alternate;
        }
        .hero-svg-waves .wave2 {
            animation: waveMove 12s linear infinite alternate-reverse;
        }

        .hero-content {
            position: relative;
            z-index: 3;
        }

        .hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(3.5rem, 10vw, 9rem);
            font-weight: 900;
            letter-spacing: -0.02em;
            line-height: 0.9;
            text-transform: uppercase;
            margin-bottom: 1rem;
            background: linear-gradient(to right, #fff, #aaa);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .hero h1 .playful {
            font-family: var(--font-playful);
            background: linear-gradient(90deg, var(--accent-playful2), var(--accent-playful), var(--accent-primary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 0.01em;
            font-size: 1.1em;
            display: inline-block;
        }

        .hero-subtitle {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            font-weight: 400;
            letter-spacing: 1px;
            color: var(--text-muted);
        }

        .scroll-indicator {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
            opacity: 0.5;
            z-index: 4;
        }

        /* Main Content */
        .main-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-bottom: 4rem;
        }

        .contact-section {
            background: rgba(255, 255, 255, 0.03);
            padding: 3rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            opacity: 0;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 300;
            letter-spacing: 2px;
            margin-bottom: 1.5rem;
            color: #ffffff;
        }

        .contact-method {
            margin-bottom: 2rem;
        }

        .contact-method h3 {
            font-size: 1rem;
            font-weight: 400;
            letter-spacing: 1px;
            color: #888888;
            margin-bottom: 0.5rem;
        }

        .contact-method a {
            color: #ffffff;
            text-decoration: none;
            font-size: 1.1rem;
            letter-spacing: 1px;
            transition: color 0.3s ease;
        }

        .contact-method a:hover { color: #888888; }

        .contact-method p {
            color: #cccccc;
            font-size: 1.1rem;
            letter-spacing: 1px;
        }

        .contact-form {
            background: rgba(255, 255, 255, 0.03);
            padding: 3rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            opacity: 0;
        }

        .form-group { margin-bottom: 2rem; }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: #888888;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 1rem;
            background: #0a0a0a;
            border: 1px solid #333333;
            color: #ffffff;
            font-family: inherit;
            font-size: 1rem;
            letter-spacing: 1px;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #666666;
        }

        .form-group textarea {
            height: 120px;
            resize: vertical;
        }

        .submit-btn {
            padding: 0.7rem 1.5rem;
            background: linear-gradient(90deg, var(--accent-playful), var(--accent-playful2), var(--accent-primary));
            color: #000;
            font-weight: 700;
            font-family: var(--font-heading);
            font-size: 1.05rem;
            letter-spacing: 1px;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease, background-position 0.4s ease;
            background-size: 200% 200%;
            background-position: left;
            border: none;
            border-radius: 24px 8px 24px 8px;
            width: 100%;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            background-position: right;
            box-shadow: 0 4px 20px 0 rgba(126,196,255,0.2);
            color: #fff;
        }

        .social-section {
            text-align: center;
            padding: 3rem 0;
            border-top: 1px solid #222222;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 3rem;
            margin-top: 2rem;
        }

        .social-links a {
            color: #888888;
            text-decoration: none;
            font-size: 1.1rem;
            letter-spacing: 1px;
            transition: color 0.3s ease;
        }

        .social-links a:hover { color: #ffffff; }

        @media (max-width: 768px) {
            .hero {
                padding-top: 6rem;
                min-height: auto;
                padding-bottom: 4rem;
            }
            .hero h1 {
                font-size: clamp(2.5rem, 12vw, 4.5rem);
            }
            .scroll-indicator {
                display: none;
            }
            .contact-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            .contact-section, .contact-form {
                padding: 1.5rem;
            }
            .main-container {
                padding: 1rem;
            }
            .social-links {
                flex-direction: column;
                gap: 1.5rem;
            }
            .section-title {
                font-size: 1.3rem;
            }
        }
    </style>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-bg"></div>
        <div class="hero-svg-waves">
            <svg viewBox="0 0 2000 180" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path class="wave1" d="M0,120 Q360,180 720,120 T1440,120 T2000,120 V180 H0 Z" fill="#7ec4ff" fill-opacity="0.18"/>
                <path class="wave2" d="M0,140 C200,140 400,100 600,140 C800,180 1000,100 1200,140 C1400,180 1600,100 1800,140 C1900,160 1950,150 2000,140 V180 H0 Z" fill="#ffb3ec" fill-opacity="0.13"/>
                <path d="M0,160 Q360,100 720,160 T1440,160 T2000,160 V180 H0 Z" fill="#ffd93d" fill-opacity="0.10"/>
            </svg>
        </div>
        <div class="hero-content">
            <h1><span class="playful">Let's</span> Talk</h1>
            <p class="hero-subtitle">Get in touch</p>
        </div>
        <div class="scroll-indicator">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
            </svg>
        </div>
    </section>

    <!-- Main Content -->
    <main class="main-container">
        <div class="contact-grid">
            <div class="contact-section">
                <h2 class="section-title">Email</h2>
                <div class="contact-method">
                    <a href="mailto:taiwoheard@gmail.com">taiwoheard@gmail.com</a>
                </div>
                <div class="contact-method">
                    <h3>What I do</h3>
                    <p>Sound meets software. From real-time audio analysis to AI-powered creative tools, I work at the junction of audio, data, and user-centered development. R&D with a soul.</p>
                </div>
            </div>

            <div class="contact-section">
                <h2 class="section-title">Quick response</h2>
                <div class="contact-method">
                    <p>I usually respond within a day or two.</p>
                </div>
                <div class="contact-method">
                    <h3>Currently working on</h3>
                    <p><strong>Biographer</strong> — AI that organizes research, not just generates words.<br><br>
<strong>Octopus Agent</strong> — See problems from every angle.<br><br>
<strong>Mixa</strong> — Intelligent sound mixing automation. No craft sacrificed.</p>
                </div>
            </div>
        </div>

        <div class="contact-form">
            <h2 class="section-title">Send a message</h2>
            <form id="contactForm" action="https://formspree.io/f/mnjqjgea" method="POST">
                <div class="form-group">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="project">Project type</label>
                    <input type="text" id="project" name="project" placeholder="Data analysis, audio research, etc. ">
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Tell me about your project..." required></textarea>
                </div>
                <button type="submit" class="submit-btn">Send message</button>
            </form>
        </div>

        <div class="social-section">
            <h2 class="section-title">Links</h2>
            <div class="social-links">
                <a href="https://www.imdb.com/name/nm2533255/" target="_blank">IMDB</a>
                <a href="https://taiheard.medium.com/" target="_blank">Medium</a>
                <a href="https://www.linkedin.com/in/taiheard/" target="_blank">LinkedIn</a>
                <a href="https://open.spotify.com/artist/1WRE3AtWxlYfLzIXcRfcg0?si=HKYtxUOpRsOFuqPhq-IraQ" target="_blank">Spotify</a>
            </div>
        </div>
    </main>

    <script is:inline>
        window.addEventListener('load', () => {
            document.querySelectorAll('.contact-section, .contact-form').forEach((section, index) => {
                setTimeout(() => {
                    section.style.opacity = '1';
                }, index * 100);
            });
        });
    </script>
</BaseLayout>



