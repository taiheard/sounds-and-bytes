---
// BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	structuredData?: any;
}

const {
	title = "Taiwo Heard - Audio Engineer & Creative Technologist",
	description = "Portfolio of Taiwo Heard: Audio engineer, composer, and creative technologist. Explore soundtracks, interactive experiences, and innovative audio tools."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>

    <!-- SEO Meta Tags -->
    <meta name="keywords" content="music production, audio engineering, creative technology, sound design, film scoring, web development, AI tools">
    <meta name="author" content="Taiwo Heard">
    <meta name="robots" content="index, follow">
    <meta name="language" content="English">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content="https://taiwoheard.com">
    <meta property="og:image" content="https://taiwoheard.com/social-card.svg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Taiwo Heard">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://taiwoheard.com/social-card.svg">
    <meta name="twitter:creator" content="@taiwoheard">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Taiwo Heard",
      "jobTitle": "Audio Engineer & Creative Technologist",
      "description": description,
      "url": "https://taiwoheard.com",
      "image": "https://taiwoheard.com/social-card.svg",
      "sameAs": [
        "https://twitter.com/taiwoheard"
      ],
      "knowsAbout": [
        "Audio Engineering",
        "Music Production",
        "Sound Design",
        "Film Scoring",
        "Creative Technology",
        "Web Development",
        "AI Tools"
      ],
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Audio Engineer",
        "occupationLocation": {
          "@type": "City",
          "name": "Los Angeles",
          "addressCountry": "US"
        }
      }
    })}></script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <!-- Import Modern Fonts + Playful Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Outfit:wght@300;700;900&family=Fredoka:wght@700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/styles.css">
    
    <slot name="head" />
</head>
<body>
    <Header />

    <slot />

    <Footer />

    <script src="/sounds-and-bytes/js/common.js" is:inline></script>
</body>
</html>

